#!/usr/bin/env bash

if [ $# -lt 2 ]
then
    echo "USAGE: pdfmerge <file1.pdf> <file2.pdf> [file3.pdf] ..."
    exit 1
fi

zenity_present=false
kdialog_present=false

if command -v zenity > /dev/null; then
    zenity_present=true
fi

if command -v kdialog > /dev/null; then
    kdialog_present=true
fi

if [ "$zenity_present" = true ]; then
    file_name=$(zenity --entry --title "File name" --text "Enter the name of the new file" | tr ' ' '_')
elif [ "$kdialog_present" = true ]; then
    file_name=$(kdialog --title "File name" --inputbox "Enter the name of the new file" | tr ' ' '_')
else
    echo "ERROR: please install either zenity or kdialog to use this script." 1>&2
    exit 1
fi

valid=$(fname_validator "$file_name")

if [[ "$valid" = "invalid" ]]; then
    echo "Invalid name of the output file." 1>&2
    exit 1
fi

# check if the input ends in ".pdf"
if [[ ${file_name^^} = *".PDF" ]]
then
    output_file=$file_name
else
    output_file="${file_name}.pdf"
fi

merge_pdf "$output_file" "$@"
