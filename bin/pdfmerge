#!/usr/bin/env bash

if [ $# -lt 2 ]
then
    echo "USAGE: pdfmerge <file1.pdf> <file2.pdf> [file3.pdf] ..."
    exit 1
fi

if command -v kdialog > /dev/null 2>&1; then
    output_file=$(kdialog --title "Save merged PDF" \
        --getsavefilename "$PWD/merged.pdf" "*.pdf|PDF files")
elif command -v zenity > /dev/null 2>&1; then
    output_file=$(zenity --file-selection --save --confirm-overwrite \
        --filename="$PWD/merged.pdf" \
        --file-filter="PDF files | *.pdf" \
        --title="Save merged PDF")
else
    echo "ERROR: please install either zenity or kdialog to use this script." 1>&2
    exit 1
fi

if [[ -z "$output_file" ]]; then
    echo "No output file selected." 1>&2
    exit 1
fi

if [[ ${output_file,,} != *.pdf ]]; then
    output_file="${output_file}.pdf"
fi

merge_pdf "$output_file" "$@"
