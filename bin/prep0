#!/usr/bin/env bash
# 
# This script prepends 0 to the name of the file.
#
# For example:
# % prep0 1.jpg    -> 01.jpg

if [ "$#" -ne 1 ]; then
    echo "USAGE: prep0 <filename>"
    exit 1
fi

if ! [ -f "$1" ]; then
	echo "ERROR: '$1' is not a file."
	exit 1
fi

fname=$(basename -- "$1")
fdir=$(dirname -- "$1")
fsource="${fdir}/${fname}"

newfname="0${fname}"
target="${fdir}/${newfname}"

if [[ -e "$target" || -L "$target" ]]; then
	echo "ERROR: destination already exists: '$target'." >&2
	exit 1
fi

echo "Original name: '$fsource'."
echo "Renaming to: '$target'..."

mv -- "$fsource" "$target"
