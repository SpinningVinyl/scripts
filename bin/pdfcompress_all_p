#!/usr/bin/env bash

# this is a wrapper script for `pdfcompress`

failed_files=()
show_dialog=false

if [[ ${1-} == "-d" ]]; then
    show_dialog=true
    shift
fi

for arg in "$@"; do
    if ! pdfcompress "$arg" -p; then
        failed_files+=("$arg")
    fi
done

if ((${#failed_files[@]})); then
    if [[ "$show_dialog" == true ]] && command -v kdialog >/dev/null 2>&1; then
        failure_text=$(printf '%s\n' "${failed_files[@]}")
        kdialog --title "PDF Compression" --error \
            "The following files were not compressed:\n\n${failure_text}"
    else
        printf '\nThe following files were not compressed:\n'
        printf '%s\n' "${failed_files[@]}"
    fi
    exit 1
fi

exit 0
