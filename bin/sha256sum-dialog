#!/usr/bin/env bash

if [ "$#" -eq 0 ]; then
    echo "USAGE: sha256sum-dialog <file> [file ...]"
    exit 1
fi

if ! command -v sha256sum >/dev/null 2>&1; then
    echo "ERROR: sha256sum not found."
    exit 1
fi

if ! command -v kdialog >/dev/null 2>&1; then
    echo "ERROR: kdialog not found."
    exit 1
fi

if ! checksums=$(sha256sum -- "$@"); then
    echo "ERROR: could not calculate checksum(s)." >&2
    exit 1
fi

# ponytail: basenames keep the dialog readable; show parent paths if duplicates matter.
display=""
while read -r checksum filename; do
    [ -n "$checksum" ] || continue
    display+="${filename##*/}"$'\n'
    display+="SHA-256: $checksum"$'\n\n'
done <<< "$checksums"

kdialog --title "SHA-256 checksums" --msgbox "$display"
