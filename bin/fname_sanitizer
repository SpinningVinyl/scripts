#!/usr/bin/env bash

# This script renames files to sanitize their names, meaning that it:
# 1) removes all "illegal" characters from the file name. "Illegal" in this context
# is anything that is not alphanumeric (as defined by your locale), '.' (period),
# '_' (underscore) or '-' (dash).
# 2) it replaces all spaces in file names with underscores.
# Usage:
# % fname_sanitizer [-d] <filename1> <filename2> <filename3> ...
# The `-d' flag shows a KDialog window with the list of files that were not renamed
# (useful when calling the script from a KServiceMenu item)

if [ -z "$1" ]; then
    echo "USAGE: fname_sanitizer [-d] <filename1> <filename2> <filename3> ..."
    exit 0
fi

failed_files=()
counter=0

show_dialog=false

if [[ ${1-} == "-d" ]]; then
    show_dialog=true
    shift
fi

for arg in "$@"; do
    fullname="$arg"
    # if not a file, skip
    if ! [ -f "$fullname" ]; then
        continue
    fi
    fname=$(basename -- "$fullname")
    fdir=$(dirname -- "$fullname")
    new_name="${fname// /_}"
    new_name="${new_name//[^[:alnum:]._-]/}"

    if [[ "$fname" != "$new_name" ]]; then
        if [[ -z "$new_name" || "$new_name" == "." || "$new_name" == ".." ]]; then
            echo "ERROR: sanitized name is invalid: '$new_name'." >&2
            failed_files+=("$fullname")
            continue
        fi

        target="${fdir}/${new_name}"

        if [[ -e "$target" || -L "$target" ]]; then
            echo "ERROR: destination already exists: '$target'." >&2
            failed_files+=("$fullname")
            continue
        fi

        if ! mv -- "$fullname" "$target"; then
            echo "ERROR: rename failed: '$fullname' to '$target'." >&2
            failed_files+=("$fullname")
            continue
        fi
        counter=$((counter+1))
    fi
done

echo "Successfully renamed $counter file(s)."

if ((${#failed_files[@]})); then
    printf "\nThe following files were not renamed:\n"
    printf '%s\n' "${failed_files[@]}"

    if [[ "$show_dialog" == true ]] && command -v kdialog >/dev/null 2>&1; then
            failure_text=$(printf '%s\n' "${failed_files[@]}")
            kdialog --title "Filename Sanitizer" --error \
                "The following files were not renamed:\n\n${failure_text}"
    fi
    exit 1
fi

exit 0
