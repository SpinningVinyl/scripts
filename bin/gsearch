#!/usr/bin/env bash

dquery="https://duckduckgo.com/?q="
diquery="https://duckduckgo.com/?iax=images&ia=images&q="
gquery="https://google.com/search?q="
gsquery="https://scholar.google.com/scholar?q="
giquery="https://www.google.com/search?site=imghp&tbm=isch&q="
wikiquery="https://en.wikipedia.org/w/index.php?fulltext=1&search="
soquery="https://stackoverflow.com/search?q="
amzquery="https://www.amazon.ie/s?k="

urlencode() {
	local input=$1
	local output="" char encoded i
	local LC_ALL=C

	for ((i = 0; i < ${#input}; i++)); do
		char=${input:i:1}
		case $char in
			[a-zA-Z0-9.~_-]) output+="$char" ;;
			' ') output+='+' ;;
			*) printf -v encoded '%%%02X' "'$char"; output+="$encoded" ;;
		esac
	done

	printf '%s' "$output"
}

zenity_present=false
kdialog_present=false

if command -v zenity > /dev/null; then
	zenity_present=true
fi
if command -v kdialog > /dev/null; then
	kdialog_present=true
fi

if [ "$zenity_present" = true ]; then
	input=$(zenity --width=800 --entry --title "Web search" --text "Enter your search query")
elif [ "$kdialog_present" = true ]; then
	input=$(kdialog --geometry 800x100 --title "Web search" --inputbox "Enter your search query")
else
	echo "ERROR: please install either zenity or kdialog to use this script."
	exit 42
fi

if [ -z "$input" ]; then
	exit 0;
fi

predicate="$(printf '%s' "$input" | cut -d ':' -f1)"
searchrq="$(printf '%s' "$input" | cut -d ':' -f2)"

searchrq=$(urlencode "$searchrq")

if [ "$predicate" = "g" ]; then
    mainquery=$gquery
    searchrq+='&udm=web'
elif [ "$predicate" = "gi" ]; then
    mainquery=$giquery
elif [ "$predicate" = "i" ]; then
    mainquery=$diquery
elif [ "$predicate" = "gs" ]; then
    mainquery=$gsquery
elif [ "$predicate" = "w" ]; then
    mainquery=$wikiquery
elif [ "$predicate" = "so" ]; then
    mainquery=$soquery
elif [ "$predicate" = "amz" ]; then
    mainquery=$amzquery
else
    mainquery=$dquery
fi

mainquery+=$searchrq

firefox "$mainquery"
activate firefox
