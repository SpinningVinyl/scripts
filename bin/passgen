#!/usr/bin/env bash

# This script generates a password using the provided dictionary
# with some numbers and special characters sprinkled on top.
# The dictionary should be in the same directory as the script.

DICT_DIR="$(dirname "$(readlink -f "$0")")"

wordnum=4
specialchars="!@#$%^&*?;:~"
rnd="/dev/urandom"

chrlen=$((${#specialchars} - 1))

dict="${DICT_DIR}/passgen.dic"

if [ ! -f "$dict" ]; then
    echo "ERROR: missing dictionary." 1>&2
    exit 1
fi

if ! command -v "shuf" >/dev/null 2>&1
then
    echo "ERROR: GNU shuf could not be found."
    exit 1
fi

mapfile -t words < <(shuf --random-source="$rnd" -r -n "$wordnum" < "$dict")

if ! [[ ${#words[@]} = "$wordnum" ]]; then
    echo "ERROR: could not read/shuffle the dictionary."
    exit 1
fi

password=""
for word in "${words[@]}"
do
    num=$(shuf --random-source="$rnd" -i 0-9 -n 1)
    key=$(shuf --random-source="$rnd" -i 0-"$chrlen" -n 1)
    special=${specialchars:key:1}
    password+="-$num${word^}$special"
done 
password=${password:1}

if command -v xclip > /dev/null; then
    xclip_present=true;
fi
if command -v wl-copy > /dev/null; then
    wlcopy_present=true;
fi

if [ "$XDG_SESSION_TYPE" = "wayland" ]
then
    if [ "$wlcopy_present" = true ]; then
        clipcommand=(wl-copy)
    else
        echo "ERROR: please install wl-clipboard to use this script in a Wayland session."
        exit 42
    fi
else
    if [ "$xclip_present" = true ]; then
        clipcommand=(xclip -i -sel clip)
    else
        echo "ERROR: please install xclip to use this script in an X11 session."
        exit 42
    fi
fi

printf '%s' "$password" | "${clipcommand[@]}"
