#!/usr/bin/env bash

shrc="$HOME/.bashrc"

echo " * Finding the location of the script..."

# shellcheck disable=SC2128
if [[ $BASH_SOURCE = */* ]]; then
    datadir="${BASH_SOURCE%/*}/"
else
    datadir="./"
fi

scriptdir="${datadir}bin"
homebindir="$HOME/bin"

if [ -d "$scriptdir" ]; then
    echo " * Symlinking user scripts to $HOME/bin"
    mkdir -p "$homebindir"
    had_conflicts=false
    for file in "$scriptdir/"*; do
        [ -f "$file" ] || continue

        basefilename=$(basename "$file")
        realfilepath=$(realpath "$file")
        binlinkpath="$homebindir/$basefilename"

        if [ -L "$binlinkpath" ]; then
            if [ "$binlinkpath" -ef "$file" ]; then
                echo "   * $binlinkpath is already linked correctly."
            else
                echo "   * Updating symlink $binlinkpath..."
                ln -sfn "$realfilepath" "$binlinkpath"
            fi
        elif [ -e "$binlinkpath" ]; then
            echo "ERROR: $binlinkpath exists and is not a symlink; leaving it unchanged." >&2
            had_conflicts=true
        else
            echo "   * Linking $realfilepath to $binlinkpath..."
            ln -s "$realfilepath" "$binlinkpath"
        fi
    done

    #shellcheck disable=SC2016
    path_export='export PATH="$HOME/bin:$PATH"'
    case ":$PATH:" in
        *":$homebindir:"*)
            ;;
        *)
            if ! grep -Fqx "$path_export" "$shrc" 2>/dev/null; then
                printf '%s\n' "$path_export" >> "$shrc"
            fi
            ;;
    esac

    if [ "$had_conflicts" = true ]; then
        exit 1
    fi
fi
